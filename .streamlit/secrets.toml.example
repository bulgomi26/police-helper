# 이 파일을 secrets.toml로 복사해서 값을 채우세요. secrets.toml은 깃허브에 올리지 마세요.
# 배포할 때는 Streamlit Community Cloud의 App settings > Secrets 칸에 같은 내용을 붙여 넣습니다.

LLM_PROVIDER = "groq"           # "groq" / "openrouter" / "alibaba"
LLM_API_KEY = "여기에-API-키"
# LLM_MODEL = ""                # 비워 두면 config.py의 기본 모델. 반드시 '도구 호출(Function Calling)' 지원 모델
#                               # (alibaba 싱가포르 리전의 qwen-plus는 도구 호출 미지원 → qwen3.6-plus 등)
# LLM_BASE_URL = ""             # 기본 주소가 안 맞을 때만 지정

# (선택) 예비 제공자: 기본 제공자가 한도 초과 등으로 실패하면 이걸로 한 번 더 시도하고,
# 그래도 안 되면 규칙 기반 기본 안내로 바뀐다
# LLM_BACKUP_PROVIDER = "alibaba"
# LLM_BACKUP_API_KEY = "여기에-예비-API-키"
# LLM_BACKUP_MODEL = ""

MAX_TURNS_PER_SESSION = 15      # 세션당 질문 수 제한 (비용·한도 보호)
MAX_AGENT_STEPS = 6             # 질문 하나당 도구 호출 최대 횟수
TURN_TIME_LIMIT = 60            # 답변 하나에 쓸 최대 시간(초). 넘으면 기본 안내로 전환
MAX_OUTPUT_TOKENS = 2000        # 호출 한 번에 받을 최대 답변 길이(토큰)
